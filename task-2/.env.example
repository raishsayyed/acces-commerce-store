# Copy to .env and fill in. Never commit .env.
# See README.md for where each value comes from.

# --- IMS OAuth server-to-server (ACCS REST) ---
IMS_TOKEN_URL=https://ims-na1.adobelogin.com/ims/token/v3
IMS_OAUTH_S2S_CLIENT_ID=
IMS_OAUTH_S2S_CLIENT_SECRET=
IMS_OAUTH_S2S_ORG_ID=

# Required scopes for Commerce REST on ACCS (comma-separated)
IMS_OAUTH_S2S_SCOPES=openid,AdobeID,email,profile,additional_info.roles,additional_info.projectedProductContext,commerce.accs

# --- ACCS REST base URL (regional host + tenant id — NOT the storefront GraphQL URL) ---
# Example: https://na1-sandbox.api.commerce.adobe.com/SbGMDobR6L2aQgb8Sdpztg
COMMERCE_API_BASE_URL=

# REST Store header for SaaS (usually "all" for admin-style catalog operations)
COMMERCE_STORE_SCOPE=all

# Optional: path to a different CSV
# INDUSTRIAL_CSV=./data/industrial-products.csv
